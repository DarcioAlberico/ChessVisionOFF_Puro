# --- Python ---
__pycache__/
*.py[oc]
build/
dist/
wheels/
*.egg-info/
.venv/
venv/
.mypy_cache/
.ruff_cache/
.pytest_cache/
.coverage
htmlcov/

# --- Dados e artefatos grandes (nao versionaveis em git puro) ---
# Amostras de treino: 3.244 PNGs, ~2,7 GB. Ver docs/ROADMAP.md (Fase 5) sobre reducao de resolucao.
data/samples/*
!data/samples/.gitkeep
data/app_tkinter_state.json
# Preferencias do usuario (S-32): contem o endpoint que ELE declarou. Versiona-lo
# reintroduziria o endereco fixo que a S-32 existe para eliminar.
data/settings.json
data/review_queue.json
# Miniaturas dos diagramas da fila de revisao (S-22): recorte de PDF protegido, e
# reconstruivel varrendo o livro de novo.
data/review_cache/
data/quarantine.csv
data/labels.csv.bak-*
data/splits.csv.bak-*
data/field_set.jsonl.bak-*
# Orfaos aposentados pelo `cvoff-audit --prune-orphans` (S-63): sao os mesmos PNGs de
# data/samples/, que ja estao fora por peso -- e o diretorio existe justamente para que a
# poda seja reversivel, nao para ser distribuido.
data/orphans/
# Galeria (S-67): o `*.index.json` e derivado do PDF (posicoes e caminhos de recorte) e
# reconstruivel varrendo o livro. O `<livro>.json` das anotacoes e trabalho humano, mas
# descreve o conteudo de um PDF protegido -- fica de fora pela mesma regra do review_cache.
data/gallery/
# Casamentos com a base de partidas (S-73): derivado do acervo protegido e de uma base de
# terceiro, e reconstruivel com `cvoff-games --all --positions --save-matches`. Fica de fora
# pelo mesmo motivo do review_cache -- mas guardar o arquivo vale muito, porque reconstrui-lo
# custa ~104 minutos e reaplica-lo custa segundos (`--from-matches`).
data/games_matches.json
data/games_matches_v2.json
# Cache de posicoes (S-84) e indice por nome (S-87/S-93): as duas respostas que a base de
# terceiro da, guardadas. Sao derivados dela e reconstruiveis -- `cvoff-games --all` refaz o
# cache (56 min nas duas gigabases) e `--build-index` refaz o indice. O sqlite tem 885 MB com
# 20,9 M partidas indexadas: o GitHub recusa acima de 100 MB, e um `git add -A` distraido o
# poria no historico para sempre. E a mesma regra do pgn_database/, pelo mesmo motivo.
data/games_positions.json
data/games_index.sqlite
data/games_index.sqlite.parcial
# Indice de procedencia (S-52): dHash de cada diagrama dos 27 PDFs. Nao e versionavel pelo
# mesmo motivo do review_cache -- e derivado de PDF protegido --, e reconstruir custa horas
# de CPU. Quem clonar o repositorio roda `cvoff-provenance --build`.
data/provenance_index.jsonl
# Compactados do dataset (`data/samples.7z` tem 1,5 GB): sao os mesmos PNGs que ja estao
# fora por peso, so que num arquivo so. O GitHub recusa acima de 100 MB, e um `git add -A`
# distraido poria isso no historico para sempre -- e do historico nao sai.
data/*.7z

# Checkpoints do modelo (~8,7 MB cada). Distribuir por release, nao por git.
# Recursivo de proposito: a Fase 5 gravou 39 MB em models/experiments/ (S-29), e
# um padrao so de primeiro nivel nao os alcanca.
models/**/*.pt
models/**/*.onnx

# --- Material de origem protegido por direito autoral ---
# NUNCA versionar: o repositorio e publico.
PDF/
# Base de partidas (10.547.416 partidas, 9,7 GB num arquivo so). E material de terceiro,
# nao cabe no GitHub (limite de 100 MB por arquivo) e nao e reconstruivel a partir daqui --
# quem clonar baixa a sua. Pela mesma razao do data/*.7z: um `git add -A` distraido poria
# isso no historico para sempre, e do historico nao sai.
pgn_database/

# --- Saida gerada ---
PGN/
logs/

# --- Lixo de execucao e artefatos locais ---
# teste-001.pgn/.ini: analise salva pela aba de Estudo e descritor de leitor externo.
teste-001.*

# --- Editores / SO ---
.vscode/
.idea/
Thumbs.db
desktop.ini
